# The organisation's timezone. Instants are stored in UTC and shown in this zone.
ORG_TIME_ZONE=Asia/Colombo

# Data adapter. "memory" runs the seeded in-memory store and needs no database.
# "postgres" runs against Supabase and needs DATABASE_URL below.
#
# Note that this chooses the *data* path only. Sign-in goes through Supabase
# Auth either way, so the three NEXT_PUBLIC_SUPABASE_* / service-role settings
# below are required even on "memory".
DATA_ADAPTER=memory

# Supabase. Both come from Project Settings > API. The publishable key is meant
# to be public; it is row-level security that protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Project Settings > API > service_role. Needed only to act on someone else's
# identity: creating the sign-in for an invited user, and `npm run db:seed`.
#
# It bypasses row-level security and can mint a session for any user. Keep it
# out of the browser and out of version control — the missing NEXT_PUBLIC_
# prefix is what stops Next inlining it into a client bundle, so do not add one.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database > Connection string (the pooled one, port 6543).
# Migrations and every transactional write go through this, not through the
# REST API, which cannot open a transaction.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
