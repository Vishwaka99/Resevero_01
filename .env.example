# Signs the session cookie. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# The organisation's timezone. Instants are stored in UTC and shown in this zone.
ORG_TIME_ZONE=Asia/Colombo

# Data adapter. "memory" runs the seeded in-memory store and needs nothing else.
# "postgres" runs against Supabase and needs the two settings below.
DATA_ADAPTER=memory

# Supabase. Both come from Project Settings > API. The publishable key is meant
# to be public; it is row-level security that protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Project Settings > Database > Connection string (the pooled one, port 6543).
# Migrations and every transactional write go through this, not through the
# REST API, which cannot open a transaction.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
